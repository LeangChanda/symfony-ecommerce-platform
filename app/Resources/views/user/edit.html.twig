
{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}

<main id="main">

    <section id="breadcrumbs" class="breadcrumbs">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h2>Edit User</h2>
                <ol>
                    <li><a href="{{ path('homepage') }}">Home</a></li>
                    <li><a href="{{ path('user_index') }}">Users</a></li>
                    <li>Edit</li>
                </ol>
            </div>
        </div>
    </section>

    <section class="inner-page">
        <div class="container">

            <div class="card">
                <div class="card-header">
                    <h4>Update User: {{ user.displayUsername }}</h4>
                </div>

                <div class="card-body">

                    {% include 'user/_form.html.twig' with {
                        form: form,
                        user: user,
                        button_label: 'Update User'
                    } %}

                </div>
            </div>

        </div>
    </section>

</main>

{% endblock %}
